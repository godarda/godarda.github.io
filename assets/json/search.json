---
layout: none
permalink: /search.json
---

{%- assign learn_segments = site.data.learn.learn.segments -%}
{%- assign tools_segments = site.data.tools.tools.segments -%}
{
  "config": {
    "learn": {{ learn_segments | map: 'url' | jsonify }},
    "tools": {{ tools_segments | map: 'url' | jsonify }}
  },
  "items": [
    {%- assign first = true -%}
    {%- assign page_urls = site.html_pages | map: 'url' -%}
    {%- assign target_segments = learn_segments | concat: tools_segments -%}
    {%- for segment in target_segments -%}
        {%- assign seg_url_slash = segment.url | prepend: '/' | append: '/' -%}
        {%- assign seg_url_html = segment.url | prepend: '/' | append: '.html' -%}
        {%- assign seg_url_exact = segment.url | prepend: '/' -%}
        {%- unless page_urls contains seg_url_slash or page_urls contains seg_url_html or page_urls contains seg_url_exact -%}
            {%- if first == false -%},{%- endif -%}
            {%- assign first = false -%}
            { "title": {{ segment.title | jsonify }}, "href": {{ segment.url | relative_url | jsonify }}, "category": {{ segment.parent | strip | jsonify }}, "content": {{ segment.title | jsonify }} }
        {%- endunless -%}
    {%- endfor -%}
    {%- for page in site.html_pages -%}
        {%- if page.title -%}
            {%- assign parts = page.url | split: '/' -%}
            {%- assign root = parts[1] | remove: ".html" -%}
            {%- unless page.url == "/search.json" or page.url == "/404.html" or page.url contains "/assets/" or root == "settings" or root == "testapp" or root == "shubhamrdarda" -%}
                {%- if first == false -%},{%- endif -%}
                {%- assign first = false -%}
                {%- assign cat = parts[1] | default: "other" -%}
                { "title": {{ page.title | jsonify }}, "href": {{ page.url | jsonify }}, "category": {{ cat | jsonify }}, "content": {{ page.content | strip_html | strip_newlines | jsonify }} }
            {%- endunless -%}
        {%- endif -%}
    {%- endfor -%}
  ]
}
